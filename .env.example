# ActualizeCRM environment — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# The comment after each key names the folder that owns it. That folder's
# CLAUDE.md has click-by-click instructions for getting the value.
#
# Note: the Prisma CLI reads .env, not .env.local. DATABASE_URL lives in .env
# and you should not need to change it.

# --- integrations/telnyx -----------------------------------------------------
# portal.telnyx.com -> API Keys -> Create API Key
TELNYX_API_KEY=

# The Call Control / WebRTC connection this machine dials through.
# MUST be unique per machine — see the clone note in CLAUDE.md.
TELNYX_CONNECTION_ID=

# The SIP username/password on that connection, used by the browser to register
# the WebRTC softphone.
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# portal.telnyx.com -> Account Settings -> Keys -> Public Key.
# NOT the API key. Telnyx signs every webhook with the matching private key, and
# the worker rejects anything it cannot verify — so with this unset, no call
# event is ever processed and the dialer records nothing. Set it on Railway.
TELNYX_PUBLIC_KEY=

# --- integrations/messaging --------------------------------------------------
# Only used once your 10DLC brand and campaign are approved. Leave blank until
# then; SMS stays hard-blocked either way.
TELNYX_MESSAGING_PROFILE=

# --- integrations/audio ------------------------------------------------------
# developer.spotify.com -> Dashboard -> your app -> Settings.
# Requires Spotify Premium. PKCE is used, so the client secret is not required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where Spotify sends you back after approving.
#   http://localhost  -> REJECTED by Spotify (deprecated)
#   http://127.0.0.1  -> ALLOWED, and what we use
# Register this exact string in the Spotify dashboard once. Unlike a
# cloudflared tunnel it never changes, so it never goes stale.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Optional. Base URL used to send you back to Settings after auth. Derived
# from the request when unset, which is usually correct.
NEXT_PUBLIC_APP_URL=

# --- integrations/email ------------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS = a 16-character Google App Password (NOT your login password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional fallback if SMTP is unavailable. resend.com, free tier = 100/day.
RESEND_API_KEY=

# --- apps/worker -------------------------------------------------------------
# The deployed worker's URL. Used only to nudge it to run a queued job now
# instead of waiting for the 20-second drain; everything still works without it.
WORKER_URL=

# Shared secret for POST /jobs/enqueue. Must match the worker's copy.
WORKER_SHARED_SECRET=

# --- sign-in gate ------------------------------------------------------------
# One operator, one credential. There is no user model, no roles and no
# invites — this exists because the app is deployed at a public URL with every
# lead behind it.
#
# AUTH_PASSWORD_HASH is `salt:scryptHash`, never the plaintext. Mint one with:
#   node -e "const{scryptSync,randomBytes}=require('crypto');const s=randomBytes(16).toString('hex');console.log(s+':'+scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
#
# AUTH_SECRET signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# --- webhook delivery (§1) ----------------------------------------------------
# Where Telnyx sends call events. On Railway this is derived automatically from
# RAILWAY_PUBLIC_DOMAIN and you do not set anything — the worker registers its
# own address with Telnyx on every boot.
#
# Set this ONLY when running the worker locally against a publicly reachable
# origin. There is no tunnel any more: the deployment has a stable hostname, and
# the check that used to demand a tunnel URL is what produced the false
# "cannot dial" state.
WEBHOOK_BASE_URL=
