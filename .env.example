# ActualizeCRM environment — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# The comment after each key names the folder that owns it. That folder's
# CLAUDE.md has click-by-click instructions for getting the value.
#
# Note: the Prisma CLI reads .env, not .env.local. DATABASE_URL lives in .env
# and you should not need to change it.

# --- integrations/telnyx -----------------------------------------------------
# portal.telnyx.com -> API Keys -> Create API Key
TELNYX_API_KEY=

# The Call Control / WebRTC connection this machine dials through.
# MUST be unique per machine — see the clone note in CLAUDE.md.
TELNYX_CONNECTION_ID=

# The SIP username/password on that connection, used by the browser to register
# the WebRTC softphone.
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# --- integrations/messaging --------------------------------------------------
# Only used once your 10DLC brand and campaign are approved. Leave blank until
# then; SMS stays hard-blocked either way.
TELNYX_MESSAGING_PROFILE=

# --- integrations/audio ------------------------------------------------------
# developer.spotify.com -> Dashboard -> your app -> Settings.
# Requires Spotify Premium. PKCE is used, so the client secret is not required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where Spotify sends you back after approving. Spotify has deprecated plain
# http://localhost redirects, so this must be an HTTPS URL — in practice the
# cloudflared tunnel:
#   https://<tunnel>.trycloudflare.com/api/spotify/callback
# It must match the Spotify dashboard entry byte for byte. Quick tunnels get a
# new hostname on every restart, so update this and the dashboard together or
# auth fails with INVALID_CLIENT.
SPOTIFY_REDIRECT_URI=

# Optional. Base URL used to send you back to Settings after auth. Derived
# from the request when unset, which is usually correct.
NEXT_PUBLIC_APP_URL=

# --- integrations/email ------------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS = a 16-character Google App Password (NOT your login password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional fallback if SMTP is unavailable. resend.com, free tier = 100/day.
RESEND_API_KEY=

# --- written automatically ---------------------------------------------------
# scripts/tunnel.ts rewrites this every time you run `npm run tunnel`.
# Do not edit by hand.
PUBLIC_WEBHOOK_URL=
