# --- secrets -----------------------------------------------------------------
# Catch-all with an explicit allow for the template. A narrower pattern like
# `.env*.local` misses backups such as `.env.local.pre-v2-urls.bak`, which is
# exactly the file most likely to leak a key.
.env*
!.env.example

# Machine-local npm cache override (hardcodes an absolute path).
.npmrc

# --- operator data -----------------------------------------------------------
# SQLite backup, uploaded voicemail audio, call recordings, Whisper models,
# exports. This is real prospect data and never belongs in the repo.
/data/

# --- dependencies ------------------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# --- build output ------------------------------------------------------------
.next/
/out/
/build
dist/
*.tsbuildinfo
/coverage

# next-pwa writes these into apps/web/public at build time.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map
apps/web/public/fallback-*.js

# --- python sidecar ----------------------------------------------------------
services/voice-ai/.venv/
__pycache__/
*.py[cod]

# --- misc --------------------------------------------------------------------
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
next-env.d.ts
.obsidian/
